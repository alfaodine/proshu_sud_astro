---
interface Props {
  isInnerPage?: boolean;
}

const { isInnerPage = false } = Astro.props;
---
<header class={`header ${isInnerPage ? 'header_page' : ''}`}>
  <div class="topbar">
    <div class="topbar__left">
      <button class="topbar__addr-btn" id="addrToggle" aria-expanded="false">
        <svg class="topbar__addr-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" fill="currentColor"/>
        </svg>
        Наші адреси
        <svg class="topbar__chevron" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <div class="topbar__dropdown" id="addrDropdown" aria-hidden="true">
        <svg class="topbar__dropdown-pin" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" fill="currentColor"/>
        </svg>
        <a class="topbar__map-link" href="https://maps.app.goo.gl/mjxybhNG4JnjhDuC8" target="_blank" rel="noopener noreferrer">Україна, Київ, метро Святошино, вулиця Академіка Туполева (Мрії), 8 (напроти прохідної заводу «Антонов»)</a>
      </div>
    </div>
    <div class="topbar__right">
      <div class="topbar__phone-btn" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z" fill="white"/>
        </svg>
      </div>
      <a class="topbar__phone-link" href="tel:+380970605906">+38 (097) 060 59 06</a>
    </div>
  </div>
  <div class="header__top">
    <a href="/">
      <svg class="icon logo-icon">
        <use xlink:href="/img/sprite.svg#logo"></use>
      </svg>
    </a>
    <button class="nav-toggle" aria-label="Toggle navigation">
      <span class="bar-top"></span>
      <span class="bar-mid"></span>
      <span class="bar-bot"></span>
    </button>
    <div class="header__menu-bg">
      <ul class="header__menu">
        <li class="menu__item">
          <a class="underline" href="/about-me">Про мене</a>
        </li>
        <li class="menu__item">
          <a class="underline" href="/how-to">Як це працює</a>
        </li>
        <li class="menu__item">
          <a class="underline" href="/contacts">Контакти</a>
        </li>
      </ul>
    </div>
  </div>
  {!isInnerPage && (
    <slot />
  )}
  {!isInnerPage && <div class="header__bg"></div>}
</header>

<script>
  const navToggle = document.querySelector('.nav-toggle');
  const menuBg = document.querySelector('.header__menu-bg');

  navToggle?.addEventListener('click', () => {
    navToggle.classList.toggle('opened');
    menuBg?.classList.toggle('active-menu');
  });

  const addrToggle = document.getElementById('addrToggle');
  const addrDropdown = document.getElementById('addrDropdown');
  const chevron = addrToggle?.querySelector('.topbar__chevron');

  addrToggle?.addEventListener('click', () => {
    const isOpen = addrDropdown?.classList.contains('open');
    addrDropdown?.classList.toggle('open');
    chevron?.classList.toggle('rotated');
    addrToggle.setAttribute('aria-expanded', String(!isOpen));
    addrDropdown?.setAttribute('aria-hidden', String(isOpen));
  });

  document.addEventListener('click', (e) => {
    if (!addrToggle?.contains(e.target as Node) && !addrDropdown?.contains(e.target as Node)) {
      addrDropdown?.classList.remove('open');
      chevron?.classList.remove('rotated');
      addrToggle?.setAttribute('aria-expanded', 'false');
      addrDropdown?.setAttribute('aria-hidden', 'true');
    }
  });
</script>
