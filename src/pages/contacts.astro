---
import PageLayout from "../layouts/PageLayout.astro";
import TgIcon from "../assets/icons/tg-icon.svg";
import WhatsupIcon from "../assets/icons/whatsup-icon.svg";
import ViberIcon from "../assets/icons/viber-icon.svg";
import EmailIcon from "../assets/icons/email-icon.svg";
import FbIcon from "../assets/icons/fb-icon.svg";
import TikTokIcon from "../assets/icons/tiktok.svg";
import ConsultationForm from "../components/react/ConsultationForm.tsx";
---

<PageLayout title="Proshu sud - Контакти">
  <main class="main">
    <section class="contacts">
      <div class="contacts__form">
        <p class="title">Отримайте онлайн консультацію</p>
        <ConsultationForm
          client:visible
          formId="form_make_online_appointment"
        />
      </div>

      <div class="contacts__social">
        <p class="title">Контакти</p>
        <ul>
          <li>
            <EmailIcon class="icon" />
            <a href="mailto:ProshuSud@gmail.com" target="_blank"
              >ProshuSud@gmail.com</a
            >
          </li>
          <li>
            <FbIcon class="icon" />
            <a href="https://www.facebook.com/mirpravaodessa" target="_blank"
              >Facebook</a
            >
          </li>
          <li>
            <TikTokIcon class="icon" />
            <a href="https://www.tiktok.com/@mir_prava" target="_blank"
              >TikTok</a
            >
          </li>
          <li>
            <a href="https://telegram.me/ohten_alina" target="_blank">
              <TgIcon class="icon" />
            </a>
            <a href="viber://pa?number=380505064272" target="_blank">
              <ViberIcon class="icon" />
            </a>
            <a
              href="https://api.whatsapp.com/send?phone=380505064272"
              target="_blank"
            >
              <WhatsupIcon class="icon" />
            </a>
          </li>
        </ul>
      </div>
    </section>
  </main>
</PageLayout>
