---
import '../styles/global.scss';

interface Props {
  title: string;
  description?: string;
  bodyId?: string;
  bodyClass?: string;
  preloadHero?: boolean;
}

const {
  title,
  description = 'Адвокат Охтень Аліна Андріївна — професійна допомога у цивільних, кримінальних та господарських справах. 20+ років досвіду, 500+ успішних справ.',
  bodyId,
  bodyClass,
  preloadHero = false,
} = Astro.props;
---
<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="uk_UA" />
  {preloadHero && (
    <link rel="preload" as="image" type="image/webp"
      imagesrcset="/img/header-photo0.5x.webp 400w, /img/header-photo0.75x.webp 600w, /img/header-photo1x.webp 800w"
      imagesizes="(max-width: 768px) 400px, (max-width: 992px) 600px, 800px"
    />
  )}
  <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/open-sans-400-cyrillic.woff2" />
  <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/prata-400-cyrillic.woff2" />
  <link rel="dns-prefetch" href="https://i.ytimg.com" />
  <link rel="icon" type="image/x-icon" href="/img/favicon.ico" />
  <title>{title}</title>
</head>
<body id={bodyId} class={bodyClass}>
  <noscript>
    <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-P7MKRK76" height="0" width="0" style="display:none;visibility:hidden"></iframe>
  </noscript>
  <slot />
</body>
</html>
