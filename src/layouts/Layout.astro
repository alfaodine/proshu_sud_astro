---
import '../styles/global.scss';

interface Props {
  title: string;
  bodyId?: string;
  bodyClass?: string;
}

const { title, bodyId, bodyClass } = Astro.props;
---
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;700&family=Prata&display=swap" />
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;700&family=Prata&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
  <noscript><link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;700&family=Prata&display=swap" rel="stylesheet" /></noscript>
  <link rel="icon" type="image/x-icon" href="/img/favicon.ico" />
  <title>{title}</title>
</head>
<body id={bodyId} class={bodyClass}>
  <noscript>
    <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-P7MKRK76" height="0" width="0" style="display:none;visibility:hidden"></iframe>
  </noscript>
  <slot />
</body>
</html>
